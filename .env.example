# Copia este archivo como .env y rellena tus claves

# Transcripción con Groq (gratis, recomendado)
# Obtén tu key en: https://console.groq.com → API Keys
GROQ_API_KEY=gsk_...

# Alternativa: transcripción con OpenAI ($0.006/min)
# OPENAI_API_KEY=sk-...

# Análisis e informe con DeepSeek (opcional, ~$0.01/reunión)
# DEEPSEEK_API_KEY=sk-...

# --- Aplicación web (opcionales) ---
# DATOS_DIR=./datos          # Dónde guardar base de datos, subidas y resultados
# MAX_SUBIDA_MB=2048         # Tamaño máximo por archivo
# CONSERVAR_AUDIO=false      # true = no borrar el audio tras procesarlo
